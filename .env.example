# =============================================================================
# JZap (ShieldProxy) — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ----- PostgreSQL / TimescaleDB -----
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=jzap
POSTGRES_USER=jzap
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ----- Control Plane -----
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
CONTROL_PLANE_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
CONTROL_PLANE_API_KEY_SALT=CHANGE_ME_GENERATE_RANDOM_32_CHAR_STRING

# ----- Proxy Node -----
PROXY_LISTEN_PORT=443
PROXY_HTTP_PORT=80
PROXY_UPSTREAM_HOST=127.0.0.1
PROXY_UPSTREAM_PORT=8080

# ----- Host Agent -----
AGENT_CONTROL_PLANE_URL=https://control-plane:8000
AGENT_SYNC_INTERVAL_SECONDS=30
AGENT_TELEMETRY_INTERVAL_SECONDS=10

# ----- mTLS -----
MTLS_CA_CERT=/certs/ca/ca.pem
MTLS_PROXY_CERT=/certs/proxy/proxy.pem
MTLS_PROXY_KEY=/certs/proxy/proxy-key.pem
MTLS_AGENT_CERT=/certs/agent/agent.pem
MTLS_AGENT_KEY=/certs/agent/agent-key.pem

# ----- Grafana -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ----- DNS Module -----
DNS_LISTEN_PORT=53
DNS_RRL_RESPONSES_PER_SECOND=5
DNS_RRL_WINDOW_SECONDS=1
